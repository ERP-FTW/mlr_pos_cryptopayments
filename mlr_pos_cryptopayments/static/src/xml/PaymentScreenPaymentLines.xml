<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenPaymentLinesCryptoPatch"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension"
       owl="1">

        <!-- Match the stable block inside the payment_status layout -->
        <xpath expr="//div[contains(@class, 'paymentline') and contains(@class, 'electronic_payment')]" position="inside">
            <t t-if="line.payment_status == 'cryptowaiting'">
                <div class="electronic_status text-warning">
                    <t t-esc="line.crypto_payment_status or 'Waiting for crypto payment confirmation...'" />
                </div>
                <div class="button highlight text-bg-warning"
                     title="Check Status"
                     t-on-click="() => this.props.sendPaymentRequest(line)">
                    Retry
                </div>
            </t>
        </xpath>

    </t>
</templates>
